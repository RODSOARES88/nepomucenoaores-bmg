# Credenciais do app "BMG Sites Sync" (Azure Entra ID · App registration)
# COPIE este arquivo para  scripts/.env  e preencha os 3 valores.
# O .env é gitignored (NUNCA vai pro repo). Não cole o secret no chat.
#
# Onde achar cada valor (portal Azure → Entra ID → App registrations → "BMG Sites Sync"):
#   AZURE_TENANT_ID  → aba Overview · "Directory (tenant) ID"
#   AZURE_CLIENT_ID  → aba Overview · "Application (client) ID"
#   AZURE_CLIENT_SECRET → aba "Certificates & secrets" → New client secret → copie o VALUE (aparece 1x só)

AZURE_TENANT_ID=cole-o-tenant-id-aqui
AZURE_CLIENT_ID=cole-o-client-id-aqui
AZURE_CLIENT_SECRET=cole-o-novo-client-secret-aqui
